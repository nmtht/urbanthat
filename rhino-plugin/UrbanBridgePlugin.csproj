<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <TargetExt>.rhp</TargetExt>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>UrbanBridgePlugin</AssemblyName>
    <RootNamespace>UrbanBridge.Rhino</RootNamespace>
    <!-- Keep Properties/AssemblyInfo.cs so the assembly Guid is present for Rhino PlugIn.Id -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.*" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="PreparePluginBundle" AfterTargets="Build">
    <PropertyGroup>
      <PluginBundleDir>$(TargetDir)package/$(AssemblyName)</PluginBundleDir>
    </PropertyGroup>
    <MakeDir Directories="$(PluginBundleDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginBundleDir)" />
  </Target>
</Project>
